{% assign citation = site.data.citations.papers[include.entry.key] %}
{% if citation and site.data.citations.scholar_userid == site.scholar_userid %}
  <a
    class="scholar-badge"
    href="https://scholar.google.com/citations?view_op=view_citation&amp;hl=en&amp;user={{ site.scholar_userid }}&amp;citation_for_view={{ site.scholar_userid }}:{{ citation.scholar_id }}"
    title="Google Scholar citations, updated {{ citation.updated_at | date: '%b %d, %Y' }}"
    aria-label="{{ citation.citations }} Google Scholar citations for {{ include.entry.title | escape }}"
  ><i class="ai ai-google-scholar" aria-hidden="true"></i> Google Scholar <strong>{{ citation.citations }}</strong></a>
{% else %}
  <a
    class="scholar-badge scholar-badge-unavailable"
    href="https://scholar.google.com/scholar?hl=en&amp;q={{ include.entry.title | strip_html | url_encode }}"
    title="Find this paper on Google Scholar; citation count not yet verified"
  ><i class="ai ai-google-scholar" aria-hidden="true"></i> Google Scholar</a>
{% endif %}
